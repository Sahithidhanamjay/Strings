36. Append Characters to String to make SubSequence
s = "coaching"
t = "coding"
Only "co" matched (2 letters), t length = 6
So need 6 - 2 = 4 characters to append: "ding"

class Solution:
    def appendCharacters(self, s: str, t: str) -> int:
        n,m=0,0
        while n<len(s) and m<len(t):
            if s[n]==t[m]:
                m+=1
            n+=1
        return len(t)-m
