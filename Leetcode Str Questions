31.	Split a string in a balanced string(1221)
s = "RLRRLLRLRL"
Traverse and count:
Group 1 → "RL"
Group 2 → "RRLL"
Group 3 → "RL"
Group 4 → "RL"
So you get 4 balanced substrings.

class Solution:
    def balancedStringSplit(self, s: str) -> int:
        n=len(s)
        if n==0:
            return 0
        l=0
        r=0
        ans=0
        for i in range(n):
            if s[i]=='R':
                r+=1
            elif s[i]=='L':
                l+=1
            if r==l:
                ans+=1
                r=0
                l=0
        return ans


