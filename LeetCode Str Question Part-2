            for j in range(i+1,len(words)):
                if set(words[i]) == set(words[j]):
                    cnt+=1
        return cnt


3.	Minimum length of string after deleting string(1750)
If letters are same, delete them from both sides.
Example:
s = "aabca"
first and last are 'a'
remove both sides
now → "abc"
again first and last not same → stop

Return remaining length
class Solution:
    def minimumLength(self, s: str) -> int:
        i=0
        j=len(s)-1
        while(i<j and s[i]==s[j]):
            c=s[i]
            while(i<=j and s[i]==c):
                i+=1
            while(i<=j and s[j]==c):
                j-=1
        return j-i+1


4.	Rotate String(796)
s = "abcde"
→ bcdea
→ cdeab
→ deabc
If any rotation equals "goal", return True

class Solution:
    def rotateString(self, s: str, goal: str) -> bool:
        x=[i for i in s]
        y=[i for i in goal]
        if len(x)!=len(y):
            return False
        v=x[::]
        for i in v:
            x.remove(i)
            x.append(i)
            if x==y:
                return True
        return False

5.	Isomorphic string (205)

class Solution:
    def isIsomorphic(self, s: str, t: str) -> bool:
        d1=[]
        d2=[]
        for i in s:
            d1.append(s.index(i))
        for i in t:
            d2.append(t.index(i))
        if d1==d2:
            return True
        return False


6.	Custom sort string(791)
reorder string s based on order string
"cba"
"s = abcd"
we should make:
"cba" first
remaining letters next
so → “cbad”

  class Solution:
    def customSortString(self, order: str, s: str) -> str:
        d={}
        for i in s:
            if i not in d:
                d[i]=1
            else:
                d[i]+=1
        a=""
        for i in order:
            if i in s:
                while(d[i]>0):
                    a+=i
                    d[i]-=1
                if d[i]==0:
                    del(d[i])
        for i in d:
            while d[i]>0:
                a+=i
                d[i]-=1
        return a


